{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-agent.local/schemas/builtin-question-bank-v1.json",
  "title": "InterviewAgent Builtin Question Bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "name", "source", "questions"],
  "properties": {
    "schema_version": { "const": "1" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "topic", "text", "answer", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["basic", "experience", "design"] },
          "topic": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "answer": { "type": "string" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
