# Required: the only secret needed by the default local server.
LLM_API_KEY=replace_with_your_openai_compatible_key

# OpenAI-compatible provider. Defaults target DashScope; change both values
# when using another compatible provider.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Lightweight single-process runtime.
HTTP_ADDR=:9090
SQLITE_PATH=data/interview.db
LLM_TIMEOUT=60s
LLM_MAX_CONCURRENCY=4
SHUTDOWN_TIMEOUT=10s

# Identity boundary. Anonymous mode is the default and automatically issues an
# HttpOnly, SameSite=Lax subject cookie. JWT mode requires separate signing and
# stable subject-derivation secrets and accepts Bearer tokens for REST and SSE.
AUTH_MODE=anonymous
JWT_SECRET=
# Keep this stable across JWT_SECRET rotation. On upgrade from the legacy
# mapping, initialize it with the pre-upgrade JWT_SECRET before rotating JWT.
SUBJECT_ID_PEPPER=
COOKIE_SECURE=false

# Cross-origin access is disabled by default. It is valid only with
# AUTH_MODE=jwt; use an explicit comma-separated origin allowlist, never `*`.
CORS_ALLOWED_ORIGINS=

# Optional enhanced/legacy drivers. They are not read or required by
# cmd/interview-server and must not be enabled on the default startup path.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=
RERANKER_TYPE=
RERANK_MODEL=
MILVUS_ADDR=
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=
MYSQL_DSN=
GITHUB_TOKEN=
