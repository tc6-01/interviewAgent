# 通义千问 DashScope API Key（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# RAG 重排策略（可选）：cross-encoder（默认，专用重排模型 gte-rerank）/ llm（LLM 全量重排）/ none（不重排）
RERANKER_TYPE=cross-encoder
# cross-encoder 使用的重排模型（RERANKER_TYPE=cross-encoder 时生效）
RERANK_MODEL=gte-rerank-v2

# Milvus 向量数据库
MILVUS_ADDR=localhost:19530

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL
MYSQL_DSN=root:interview@tcp(localhost:3306)/interview_agent?charset=utf8mb4&parseTime=True&loc=Local

# GitHub（可选，用于复习计划推荐真实开源项目）
GITHUB_TOKEN=

# JWT 认证密钥（生产环境请替换为随机字符串）
JWT_SECRET=interview-agent-default-secret
